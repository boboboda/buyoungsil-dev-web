generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String?   @default("user")
  // "모든 기기에서 로그아웃"을 누를 때마다 1씩 올라간다. 쿠키 안의 값(sv)과 다르면 그 로그인은 무효.
  sessionVersion Int      @default(0)
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DevelopNote {
  id              String   @id @default(cuid())
  noteId          Int      @unique
  title           String?
  content         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mainCategory    String?
  subCategory     Json?
  level           String   @default("BEGINNER")
  isPublished     Boolean  @default(false)
  metaDescription String?
  metaTitle       String?
  relatedNoteIds  Int[]    @default([])

  @@index([isPublished])
  @@index([mainCategory])
  @@map("developNote")
}


model ProjectTag {
  id        String  @id @default(cuid())
  name      String
  color     String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_tags")
}

model ProjectLog {
  id        String   @id @default(cuid())
  projectId String
  title     String
  content   String
  logType   String
  noteId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([noteId])
  @@map("project_logs")
}

model Revenue {
  id        String   @id @default(cuid())
  projectId String
  month     String
  adsense   Int      @default(0)
  inapp     Int      @default(0)
  total     Int      @default(0)
  dau       Int?
  mau       Int?
  downloads Int?
  retention Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month])
  @@index([month])
  @@map("revenues")
}

model Story {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String
  excerpt         String?
  category        String
  tags            String[]
  isPublished     Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("stories")
}

model Post {
  id         String    @id @default(uuid())
  listNumber Int
  writer     String
  title      String
  content    String
  createdAt  DateTime  @default(now()) @map("created_at")
  appName    String
  postType   String
  email      String
  comments   Comment[]

  @@index([appName, postType])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  writer    String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  postId    String   @map("post_id")
  email     String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  replies   Reply[]

  @@map("comments")
}

model Reply {
  id        String   @id @default(uuid())
  writer    String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  commentId String   @map("comment_id")
  email     String
  mentionTo String?
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("replies")
}

model App {
  id          String   @id @default(cuid())
  name        String   @unique
  title       String
  description String
  appLink     String
  coverImage  String?
  databaseId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        Tag[]
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String
  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, name])
}

model DailyVisitorCount {
  id    String @id @default(cuid())
  date  String @unique @map("visit_date")
  count Int    @default(0)

  @@map("daily_visitor_counts")
}

model TotalVisitorCount {
  id         String @id @default("singleton")
  totalCount Int    @default(0) @map("total_count")

  @@map("total_visitor_counts")
}





model Project {
  id          String       @id @default(cuid())
  name        String       @unique
  title       String
  description String       @db.Text
  coverImage  String?
  appLink     String?
  
  // 🔥 플랫폼 (상위 분류)
  platform    String       // "mobile" | "web" | "backend"
  
  // 🔥 상태 관리
  status      String       @default("in-progress")
  // "released" | "in-progress" | "backend"

    // 🔥 기술 스택 (노트 연결용) - 배열로 저장
  techStack   String[]     @default([])

  
  progress    Int          @default(0)
  databaseId  String?

  // 🔥 개인정보처리방침 (마크다운 본문 + 시행일)
  privacyPolicy    String?   @db.Text
  privacyUpdatedAt DateTime?

  tags        ProjectTag[]
  logs        ProjectLog[]
  revenues    Revenue[]
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("projects")
  @@index([platform])
  @@index([status])
}

model NoteCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  
  // 🔥 플랫폼 (상위 분류)
  platform    String?  // "mobile" | "web" | "backend" | null (basics)

  // 🔥 카드 표시 / SEO (관리자 화면에서 수정)
  gradient        String?  // 색상 프리셋 키 (lib/note/categoryUtils.ts)
  imageUrl        String?  // 카드 대표 이미지 (없으면 아이콘 표시)
  tags            String[] @default([])
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[] @default([])
  
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("note_categories")
  @@index([platform])
  @@index([isPublished])
}


// 🔥 서브 카테고리 (메인 카테고리별로 관리)
model NoteSubCategory {
  id           String   @id @default(cuid())
  mainCategory String   // NoteCategory 슬러그 ("flutter", "react" ...)
  name         String
  order        Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([mainCategory, name])
  @@index([mainCategory])
  @@map("note_sub_categories")
}


model WorkRequest {
  id          String   @id @default(cuid())
  
  // 신청자 정보
  name        String
  email       String
  company     String?
  phone       String?
  
  // 프로젝트 정보
  projectType String   // "mobile" | "web" | "backend" | "consulting"
  budget      String   // "1000만원 이하" | "1000-3000만원" | "3000-5000만원" | "5000만원 이상"
  timeline    String   // "1개월" | "2-3개월" | "3-6개월" | "6개월 이상"
  
  // 상세 내용
  title       String
  description String   @db.Text
  requirements String?  @db.Text
  reference   String?  // 참고 URL
  
  // 상태 관리
  status      String   @default("pending") 
  // "pending" | "reviewing" | "accepted" | "rejected" | "completed"
  
  // 관리자 메모
  adminNote   String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("work_requests")
  @@index([status])
  @@index([createdAt])


  
}

// ===== prisma/schema.prisma 맨 아래에 추가 =====

// 분석 대상 앱 목록과 수집 키
model AnalyticsApp {
  id        String   @id @default(cuid())
  appId     String   @unique // 사람이 읽는 앱 이름 (예: "exchange-rate")
  name      String
  ingestKey String   @unique // 앱이 이벤트를 보낼 때 헤더로 보내는 키
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  events       AnalyticsEvent[]
  installs     AnalyticsInstall[]
  dailyActives DailyActiveInstall[]

  @@map("analytics_apps")
}

// 원본 이벤트 (90일 보관 예정)
model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  appId      String
  eventId    String // 앱이 만든 UUID. 재전송해도 한 번만 저장
  installId  String
  sessionId  String?
  name       String
  params     Json?
  appVersion String?
  platform   String?
  osVersion  String?
  occurredAt DateTime
  receivedAt DateTime @default(now())

  app AnalyticsApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, eventId])
  @@index([appId, occurredAt])
  @@index([appId, name, occurredAt])
  @@index([appId, installId, occurredAt])
  @@map("analytics_events")
}

// 설치(기기)별 첫 접속, 마지막 접속, 버전
model AnalyticsInstall {
  appId       String
  installId   String
  firstSeenAt DateTime
  lastSeenAt  DateTime
  appVersion  String?
  platform    String?
  osVersion   String?

  app AnalyticsApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, installId])
  @@index([appId, lastSeenAt])
  @@index([appId, firstSeenAt])
  @@map("analytics_installs")
}

// 하루에 한 번이라도 앱을 연 설치 (한국 시간 기준 날짜)
model DailyActiveInstall {
  appId     String
  date      String // yyyy-MM-dd (KST)
  installId String

  app AnalyticsApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, date, installId])
  @@index([appId, date])
  @@map("daily_active_installs")
}

// ========================================
// 특수교육 도구함(edu) 게시판
// edu 사이트 서버가 /api/edu/* 로만 접근한다. 기존 posts 테이블과는 분리.
// ========================================
model EduPost {
  id           String   @id @default(cuid())
  board        String // "request" (앱·도구 요청, 공개) | "contact" (문의, 비밀글)
  nickname     String
  passwordHash String // scrypt$salt$hash (원문 비밀번호는 저장하지 않음)
  title        String
  content      String   @db.Text
  isSecret     Boolean  @default(false)
  status       String   @default("open") // "open" | "reviewing" | "planned" | "done"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  replies EduReply[]

  @@index([board, createdAt])
  @@map("edu_posts")
}

model EduReply {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  post EduPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("edu_replies")
}

// 초안함: Claude 스킬이 보낸 글 초안. 관리자가 분류를 정해 개발노트/스토리(비공개)로 보내거나 버린다.
model Draft {
  id                  String    @id @default(cuid())
  title               String
  markdown            String    // 본문(마크다운). 보낼 때 Lexical 로 변환
  recommendedTarget   String?   // "note" | "story" (스킬이 추천한 구분)
  recommendedSection  String?   // 추천 섹션 (NoteCategory.slug 또는 이름)
  recommendedCategory String?   // 추천 카테고리 (세부 카테고리 또는 스토리 분류)
  level               String    @default("BEGINNER")
  tags                String[]  @default([])
  source              String?   // 어느 대화/프로젝트에서 왔는지 (선택)
  status              String    @default("pending") // pending | sent | discarded
  sentType            String?   // "note" | "story"
  sentRef             String?   // 보낸 노트의 noteId 또는 스토리 id
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("drafts")
}

// ========================================
// Claude Code 작업 현황
// 사용자 PC의 Claude Code 훅이 /api/claude-status 로 보낸 이벤트를 저장한다.
// 프롬프트·코드 내용은 받지도 저장하지도 않는다. (세션 ID, 폴더 이름, 기기 이름, 도구 이름, 토큰 수치만)
// ========================================

// 세션 하나의 현재 상태. 같은 세션의 이벤트가 오면 이 행을 갱신한다.
model ClaudeSession {
  id                String   @id // Claude Code 세션 ID
  device            String // 기기 이름 (예: homeserver, laptop)
  project           String // 작업 폴더 이름 (cwd 의 마지막 폴더)
  status            String   @default("idle") // working | waiting | idle | ended
  lastEvent         String
  lastTool          String?
  startedAt         DateTime
  lastEventAt       DateTime
  // 세션 누적 토큰. 훅 스크립트가 transcript 에서 합산해 보낸 가장 최근 값
  inputTokens       BigInt   @default(0)
  outputTokens      BigInt   @default(0)
  cacheCreateTokens BigInt   @default(0)
  cacheReadTokens   BigInt   @default(0)

  events ClaudeEvent[]

  @@index([lastEventAt])
  @@map("claude_sessions")
}

// 의미 있는 이벤트만 쌓는다. (도구 호출 이벤트는 세션 행만 갱신하고 여기엔 쌓지 않는다)
// 토큰 증가분(…Delta)은 "최근 5시간 사용량" 추정에 쓴다.
model ClaudeEvent {
  id               Int      @id @default(autoincrement())
  sessionId        String
  event            String
  at               DateTime
  inputDelta       Int      @default(0)
  outputDelta      Int      @default(0)
  cacheCreateDelta Int      @default(0)
  cacheReadDelta   Int      @default(0)

  session ClaudeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
  @@index([at])
  @@map("claude_events")
}

// 하루(한국 시간) × 기기 × 프로젝트별 토큰 사용량 합계
model ClaudeDailyUsage {
  date              String // yyyy-MM-dd (KST)
  device            String
  project           String
  inputTokens       BigInt @default(0)
  outputTokens      BigInt @default(0)
  cacheCreateTokens BigInt @default(0)
  cacheReadTokens   BigInt @default(0)

  @@id([date, device, project])
  @@index([date])
  @@map("claude_daily_usage")
}
