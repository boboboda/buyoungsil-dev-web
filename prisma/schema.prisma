generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String?   @default("user")
  // "모든 기기에서 로그아웃"을 누를 때마다 1씩 올라간다. 쿠키 안의 값(sv)과 다르면 그 로그인은 무효.
  sessionVersion Int      @default(0)
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DevelopNote {
  id              String   @id @default(cuid())
  noteId          Int      @unique
  title           String?
  content         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mainCategory    String?
  subCategory     Json?
  level           String   @default("BEGINNER")
  isPublished     Boolean  @default(false)
  metaDescription String?
  metaTitle       String?
  relatedNoteIds  Int[]    @default([])

  @@index([isPublished])
  @@index([mainCategory])
  @@map("developNote")
}


model ProjectTag {
  id        String  @id @default(cuid())
  name      String
  color     String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_tags")
}

model ProjectLog {
  id        String   @id @default(cuid())
  projectId String
  title     String
  content   String
  logType   String
  noteId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([noteId])
  @@map("project_logs")
}

model Revenue {
  id        String   @id @default(cuid())
  projectId String
  month     String
  adsense   Int      @default(0)
  inapp     Int      @default(0)
  total     Int      @default(0)
  dau       Int?
  mau       Int?
  downloads Int?
  retention Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month])
  @@index([month])
  @@map("revenues")
}

model Story {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String
  excerpt         String?
  category        String
  tags            String[]
  isPublished     Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("stories")
}

model Post {
  id         String    @id @default(uuid())
  listNumber Int
  writer     String
  title      String
  content    String
  createdAt  DateTime  @default(now()) @map("created_at")
  appName    String
  postType   String
  email      String
  comments   Comment[]

  @@index([appName, postType])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  writer    String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  postId    String   @map("post_id")
  email     String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  replies   Reply[]

  @@map("comments")
}

model Reply {
  id        String   @id @default(uuid())
  writer    String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  commentId String   @map("comment_id")
  email     String
  mentionTo String?
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("replies")
}

model App {
  id          String   @id @default(cuid())
  name        String   @unique
  title       String
  description String
  appLink     String
  coverImage  String?
  databaseId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        Tag[]
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String
  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, name])
}

model DailyVisitorCount {
  id    String @id @default(cuid())
  date  String @unique @map("visit_date")
  count Int    @default(0)

  @@map("daily_visitor_counts")
}

model TotalVisitorCount {
  id         String @id @default("singleton")
  totalCount Int    @default(0) @map("total_count")

  @@map("total_visitor_counts")
}





model Project {
  id          String       @id @default(cuid())
  name        String       @unique
  title       String
  description String       @db.Text
  coverImage  String?
  appLink     String?
  
  // 🔥 플랫폼 (상위 분류)
  platform    String       // "mobile" | "web" | "backend"
  
  // 🔥 상태 관리
  status      String       @default("in-progress")
  // "released" | "in-progress" | "backend"

    // 🔥 기술 스택 (노트 연결용) - 배열로 저장
  techStack   String[]     @default([])

  
  progress    Int          @default(0)
  databaseId  String?

  // 🔥 개인정보처리방침 (마크다운 본문 + 시행일)
  privacyPolicy    String?   @db.Text
  privacyUpdatedAt DateTime?

  tags        ProjectTag[]
  logs        ProjectLog[]
  revenues    Revenue[]
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("projects")
  @@index([platform])
  @@index([status])
}

model NoteCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  
  // 🔥 플랫폼 (상위 분류)
  platform    String?  // "mobile" | "web" | "backend" | null (basics)

  // 🔥 카드 표시 / SEO (관리자 화면에서 수정)
  gradient        String?  // 색상 프리셋 키 (lib/note/categoryUtils.ts)
  imageUrl        String?  // 카드 대표 이미지 (없으면 아이콘 표시)
  tags            String[] @default([])
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[] @default([])
  
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("note_categories")
  @@index([platform])
  @@index([isPublished])
}


// 🔥 서브 카테고리 (메인 카테고리별로 관리)
model NoteSubCategory {
  id           String   @id @default(cuid())
  mainCategory String   // NoteCategory 슬러그 ("flutter", "react" ...)
  name         String
  order        Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([mainCategory, name])
  @@index([mainCategory])
  @@map("note_sub_categories")
}


model WorkRequest {
  id          String   @id @default(cuid())
  
  // 신청자 정보
  name        String
  email       String
  company     String?
  phone       String?
  
  // 프로젝트 정보
  projectType String   // "mobile" | "web" | "backend" | "consulting"
  budget      String   // "1000만원 이하" | "1000-3000만원" | "3000-5000만원" | "5000만원 이상"
  timeline    String   // "1개월" | "2-3개월" | "3-6개월" | "6개월 이상"
  
  // 상세 내용
  title       String
  description String   @db.Text
  requirements String?  @db.Text
  reference   String?  // 참고 URL
  
  // 상태 관리
  status      String   @default("pending") 
  // "pending" | "reviewing" | "accepted" | "rejected" | "completed"
  
  // 관리자 메모
  adminNote   String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("work_requests")
  @@index([status])
  @@index([createdAt])


  
}

// ===== prisma/schema.prisma 맨 아래에 추가 =====

// 분석 대상 앱 목록과 수집 키
model AnalyticsApp {
  id        String   @id @default(cuid())
  appId     String   @unique // 사람이 읽는 앱 이름 (예: "exchange-rate")
  name      String
  ingestKey String   @unique // 앱이 이벤트를 보낼 때 헤더로 보내는 키
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  events       AnalyticsEvent[]
  installs     AnalyticsInstall[]
  dailyActives DailyActiveInstall[]

  @@map("analytics_apps")
}

// 원본 이벤트 (90일 보관 예정)
model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  appId      String
  eventId    String // 앱이 만든 UUID. 재전송해도 한 번만 저장
  installId  String
  sessionId  String?
  name       String
  params     Json?
  appVersion String?
  platform   String?
  osVersion  String?
  occurredAt DateTime
  receivedAt DateTime @default(now())

  app AnalyticsApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, eventId])
  @@index([appId, occurredAt])
  @@index([appId, name, occurredAt])
  @@index([appId, installId, occurredAt])
  @@map("analytics_events")
}

// 설치(기기)별 첫 접속, 마지막 접속, 버전
model AnalyticsInstall {
  appId       String
  installId   String
  firstSeenAt DateTime
  lastSeenAt  DateTime
  appVersion  String?
  platform    String?
  osVersion   String?

  app AnalyticsApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, installId])
  @@index([appId, lastSeenAt])
  @@index([appId, firstSeenAt])
  @@map("analytics_installs")
}

// 하루에 한 번이라도 앱을 연 설치 (한국 시간 기준 날짜)
model DailyActiveInstall {
  appId     String
  date      String // yyyy-MM-dd (KST)
  installId String

  app AnalyticsApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, date, installId])
  @@index([appId, date])
  @@map("daily_active_installs")
}

// ========================================
// 특수교육 도구함(edu) 게시판
// edu 사이트 서버가 /api/edu/* 로만 접근한다. 기존 posts 테이블과는 분리.
// ========================================
model EduPost {
  id           String   @id @default(cuid())
  board        String // "request" (앱·도구 요청, 공개) | "contact" (문의, 비밀글)
  nickname     String
  passwordHash String // scrypt$salt$hash (원문 비밀번호는 저장하지 않음)
  title        String
  content      String   @db.Text
  isSecret     Boolean  @default(false)
  status       String   @default("open") // "open" | "reviewing" | "planned" | "done"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  replies EduReply[]

  @@index([board, createdAt])
  @@map("edu_posts")
}

model EduReply {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  post EduPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("edu_replies")
}

// 초안함: Claude 스킬이 보낸 글 초안. 관리자가 분류를 정해 개발노트/스토리(비공개)로 보내거나 버린다.
model Draft {
  id                  String    @id @default(cuid())
  title               String
  markdown            String    // 본문(마크다운). 보낼 때 Lexical 로 변환
  recommendedTarget   String?   // "note" | "story" (스킬이 추천한 구분)
  recommendedSection  String?   // 추천 섹션 (NoteCategory.slug 또는 이름)
  recommendedCategory String?   // 추천 카테고리 (세부 카테고리 또는 스토리 분류)
  level               String    @default("BEGINNER")
  tags                String[]  @default([])
  source              String?   // 어느 대화/프로젝트에서 왔는지 (선택)
  status              String    @default("pending") // pending | sent | discarded
  sentType            String?   // "note" | "story"
  sentRef             String?   // 보낸 노트의 noteId 또는 스토리 id
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("drafts")
}

// ========================================
// Claude Code 작업 현황
// 사용자 PC의 Claude Code 훅이 /api/claude-status 로 보낸 이벤트를 저장한다.
// 프롬프트·코드 내용은 받지도 저장하지도 않는다. (세션 ID, 폴더 이름, 기기 이름, 도구 이름, 토큰 수치만)
// ========================================

// 세션 하나의 현재 상태. 같은 세션의 이벤트가 오면 이 행을 갱신한다.
model ClaudeSession {
  id                String   @id // Claude Code 세션 ID
  device            String // 기기 이름 (예: homeserver, laptop)
  project           String // 작업 폴더 이름 (cwd 의 마지막 폴더)
  status            String   @default("idle") // working | waiting | idle | ended
  lastEvent         String
  lastTool          String?
  startedAt         DateTime
  lastEventAt       DateTime
  // 세션 누적 토큰. 훅 스크립트가 transcript 에서 합산해 보낸 가장 최근 값
  inputTokens       BigInt   @default(0)
  outputTokens      BigInt   @default(0)
  cacheCreateTokens BigInt   @default(0)
  cacheReadTokens   BigInt   @default(0)

  events ClaudeEvent[]

  @@index([lastEventAt])
  @@map("claude_sessions")
}

// 의미 있는 이벤트만 쌓는다. (도구 호출 이벤트는 세션 행만 갱신하고 여기엔 쌓지 않는다)
// 토큰 증가분(…Delta)은 "최근 5시간 사용량" 추정에 쓴다.
model ClaudeEvent {
  id               Int      @id @default(autoincrement())
  sessionId        String
  event            String
  at               DateTime
  inputDelta       Int      @default(0)
  outputDelta      Int      @default(0)
  cacheCreateDelta Int      @default(0)
  cacheReadDelta   Int      @default(0)

  session ClaudeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
  @@index([at])
  @@map("claude_events")
}

// 하루(한국 시간) × 기기 × 프로젝트별 토큰 사용량 합계
model ClaudeDailyUsage {
  date              String // yyyy-MM-dd (KST)
  device            String
  project           String
  inputTokens       BigInt @default(0)
  outputTokens      BigInt @default(0)
  cacheCreateTokens BigInt @default(0)
  cacheReadTokens   BigInt @default(0)

  @@id([date, device, project])
  @@index([date])
  @@map("claude_daily_usage")
}

// AI 구독 한도 사용률의 최신 스냅샷. AI 하나에 1행(claude | codex), 받을 때마다 덮어쓴다.
// claude: 작업 PC 상태줄 스크립트가 rate_limits 를 보냄. codex: 작업 PC 수집 스크립트가 비공식 사용량 주소에서 읽어 보냄.
model AiUsageLimit {
  provider         String    @id // claude | codex
  device           String // 보낸 기기 이름
  fiveHourPct      Float? // 5시간 창 사용률 0~100. 없으면 null
  fiveHourResetsAt DateTime?
  sevenDayPct      Float? // 7일 창 사용률 0~100
  sevenDayResetsAt DateTime?
  asOf             DateTime? // 값을 읽은 시각(작업 PC 기준). 이보다 오래된 값은 덮어쓰지 않음
  failedAt         DateTime? // 마지막 자동 수집 실패 시각 (자동 수집이 성공하면 비움)
  failReason       String? // 그 실패의 짧은 사유(예: "HTTP 429 요청 제한 · 15분 뒤 다시")
  source           String? // 지금 값의 출처: statusline | auto | stream
  extraWindows     Json? // 모델별 주간 한도 등: { asOf, windows: [{ key, usedPct, resetsAt }] }
  modelTokens      Json? // 오늘(KST) 모델별 토큰 수: { date, asOf, models: { fable, opus, sonnet, haiku, other } } (claude 만)
  updatedAt        DateTime  @updatedAt

  @@map("ai_usage_limits")
}

// ─────────────────────────────────────────────
// 앱 공장 (factory): 기획서를 지시로 쌓고, 내 PC 의 감독 프로그램이 가져가 앱을 만든다.
// 기존 모델과는 연결하지 않는다. (ClaudeSession 과는 appSlug = project 이름으로만 맞춘다)
// ─────────────────────────────────────────────

// 지시 대기열. 앱 하나 = 활성 지시 하나.
model FactoryJob {
  id              String    @id @default(cuid())
  appSlug         String // 앱 폴더 이름(영문 소문자·숫자·하이픈). ClaudeSession.project 와 같다.
  title           String // 표시용 앱 이름
  kind            String    @default("new") // new | revision (수정 지시)
  parentJobId     String? // 수정 지시가 이어받는 이전 지시
  parentExplicit  Boolean   @default(false) // 등록 요청에 parentJobId 를 직접 적었는가(true 면 실행 시작 때 부모를 다시 정하지 않는다)
  planMarkdown    String // 확정된 기획서 본문(수정 지시는 고칠 내용만)
  planHash        String // 기획서 sha256. 같은 기획서 중복 등록 감지
  stack           String    @default("flutter") // 앱 템플릿 종류
  aiEngine        String    @default("claude") // claude | codex. 기존 일감은 Claude 유지
  aiModel         String? // Claude Code --model 별칭(승인 때 고름, lib/factory/ai.ts CLAUDE_MODELS). NULL = 기본 설정(시작 때 기본 모델로 채움). Codex 는 늘 NULL
  requiredSecrets String[]  @default([]) // 키 이름만. 값은 저장하지 않는다.
  priority        Int       @default(0)
  status          String    @default("pending") // pending | approved | running | review(출시 검토 대기) | done | failed | cancelled
  phase           String? // 워커가 보고하는 현재 단계(scaffold, build, screenshots 등)
  summary         String? // 완료 요약
  failReason      String?
  attempts        Int       @default(0)
  maxAttempts     Int       @default(2)
  workerId        String? // 가져간 감독 프로그램 이름
  leaseUntil      DateTime? // running 상태의 임대 만료 시각
  source          String? // 어느 기획 대화에서 왔는지(선택)
  releaseKind     String? // 출시 일감 종류: first(첫 출시) | store(스토어 자료 수정) | project(프로젝트 업데이트). NULL 은 예전 일감(first)
  failStage       String? // 실패한 단계(key, build, sign, upload, homepage, store 등)
  resumeFrom      String? // 재시도 때 이 단계부터 다시
  resumeNote      String? // 재시도 때 넘기는 이전 실패 이유(마스킹됨)
  overwriteProject Boolean  @default(false) // 출시 일감(store/project): 홈페이지 프로젝트의 기존 값도 덮어쓰기(개인정보처리방침 제외)
  updateItems     String[]  @default([]) // 출시 일감(store/project): 갱신할 항목(images, listing, video, privacy / description, cover, privacy). 빈 배열은 예전 일감(예전 동작)
  reviewRequired  Boolean   @default(false) // 출시 일감(첫 출시·스토어 수정): 생성 뒤 '검토 대기'(status=review)에서 사람이 확인해야 반영
  reviewAt        DateTime? // 검토 대기가 된 시각
  reviewApprovedAt DateTime? // [이대로 진행] 누른 시각. 이 뒤에만 Play 업로드·홈페이지 반영·완료
  redoNote        String?   @db.Text // [다시 만들기] 수정 요청 메모(이 항목만 다시)
  versionName     String? // 앱 업데이트: 원하는 버전 이름(비우면 patch +1)
  releaseNotes    String?   @db.Text // 앱 업데이트: 출시 노트(What's new, 비우면 공장이 초안)
  buildResult     Json? // 앱 업데이트 결과: 버전 이름·코드, AAB 크기, 시험 요약, 업로드 트랙
  toolRequests    Json? // 도구 요청 중계 목록: [{ id, tool, status, at, ms, message }] (비밀값 없음)
  labResult       Json? // 실험(lab) 일감 결과: 건너뛴 파일 목록·사후 검사(저장소 변경)·폴더 지움 표시. 비밀값 없음
  labCleanupAt    DateTime? // 실험 [폴더 지우기]를 요청한 시각(감독 프로그램이 지우고 알리면 labResult.folderDeleted)
  parallelGroup   String? // 병행 그룹: 같은 앱·같은 그룹의 승인된 수정 일감은 worktree 에서 동시에 실행한다(NULL = 앱당 1개). lib/factory/parallel.ts
  parallelInfo    Json? // 감독 프로그램이 보고하는 병행 상태(worktree·lockWait·merging·rebases·mergedAt·checks). 비밀값 없음
  parallelSource  String? // 병행 그룹을 정한 쪽: manual(사람이 묶거나 푼 일감: 지휘자는 건드리지 않음) | conductor(지휘자가 자동으로 묶음). lib/factory/conductor.ts
  conductorInfo   Json? // 지휘자 판단(결정·이유·예상 파일·영역·확신도·판단 키). 비밀값 없음
  cardId          String? // 결과물 카드(factory_cards.id): 있으면 이 카드의 도구·방법·옵션·참고 규칙으로 실행한다(2-2). NULL = 예전 방식(프로젝트 도구 설정)
  toolInput       Json? // 도구 일감(kind=tool) 입력: { count, subjects, extra, refArtIds, estimatedCost, confirmed } (lib/factory/toolJobs.ts). 키 값 없음
  toolResult      Json? // 도구 일감 결과: { cost, arts:[{url,subject,kind}], message, needsConfirmation }. 키 값 없음
  handoff         Json? // 인계 기록 마지막 항목(Claude Code ↔ Codex 공유 인계, 읽기 전용 표시용). lib/factory/handoff.ts 가 정리해서 저장. 비밀값·기획서·diff 없음
  planFirst       Boolean   @default(false) // 계획 먼저 승인(5-1): true 면 작업자가 일하기 전에 읽기 전용 AI 가 계획을 내고 사람이 고른다
  planStatus      String? // 계획 단계: requested(계획 만들 차례) | running(감독 프로그램이 만드는 중) | ready(사람 선택 대기) | failed(계획을 못 만듦) | approved(이대로 진행). NULL = 계획 단계 없음
  planText        String?   @db.Text // 읽기 전용 AI 가 낸 계획(3~6줄). 승인하면 작업자 지시문 끝에 붙는다
  planNote        String?   @db.Text // [수정 지시]로 사람이 적은 말(다음 계획에 반영)
  planInfo        Json? // 계획 턴 정보: { model, ms, costUsd, tokens, at, rounds, startedAt, reason }. 비밀값 없음
  diffInfo        Json? // 끝난 일감의 변경 내용: 파일 목록·줄 수·파일별 diff(한도·비밀 파일 숨김은 lib/factory/diffReport.ts)
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  updatedAt       DateTime  @updatedAt

  images FactoryJobImage[]
  logs   FactoryJobLog[]
  labFiles FactoryLabFile[]

  @@index([status, priority, createdAt])
  @@index([appSlug])
  @@index([appSlug, parallelGroup])
  @@index([createdAt, id]) // 통제실 이력 [앱 일감]: 전체 최신순 쪽 나누기
  @@map("factory_jobs")
}

model FactoryJobImage {
  id        String     @id @default(cuid())
  jobId     String
  label     String // 화면 이름(home, result 등)
  url       String // 업로드 서버가 돌려준 전체 URL
  createdAt DateTime   @default(now())
  job       FactoryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("factory_job_images")
}

// 실험(lab) 일감 결과 파일(이미지·mp4·report.md). 감독 프로그램이 8MB 이하 조각으로 올리고, 통제실(관리자)·커넥터(서명 주소)가 읽는다.
model FactoryLabFile {
  id         String     @id @default(cuid())
  jobId      String
  name       String // outputs/ 아래 상대 경로(슬래시)
  kind       String // image | video | report
  mime       String
  size       Int
  chunkCount Int
  received   Int        @default(0)
  complete   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  job        FactoryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  chunks     FactoryLabFileChunk[]

  @@unique([jobId, name])
  @@map("factory_lab_files")
}

model FactoryLabFileChunk {
  fileId String
  idx    Int
  data   Bytes
  file   FactoryLabFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([fileId, idx])
  @@map("factory_lab_file_chunks")
}

model FactoryJobLog {
  id      Int        @id @default(autoincrement())
  jobId   String
  at      DateTime   @default(now())
  level   String     @default("info") // info | warn | error
  message String // 2000자 이내
  job     FactoryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, at])
  @@map("factory_job_logs")
}

// 키 이름 카탈로그. 값은 PC 의 마스터 파일에만 있다.
model FactorySecretName {
  name        String   @id // 예: PIXELLAB_TOKEN
  description String // 어디에 쓰는 키인지
  createdAt   DateTime @default(now())

  @@map("factory_secret_names")
}

// 앱 공장 작업 PC(감독 프로그램)용 접속 토큰. 홈페이지 통제실에서 발급하고, 원문은 발급 때 한 번만 보여 준다.
model FactoryWorkerToken {
  id         String    @id @default(cuid())
  name       String // 기기 이름(예: mainpc). 감독 프로그램의 worker 이름과 같게 쓴다.
  tokenHash  String    @unique // 토큰 sha256(hex). 원문은 저장하지 않는다.
  prefix     String // 목록에서 구분하려고 보여 주는 앞 8자
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // 마지막으로 접속한 시각

  @@map("factory_worker_tokens")
}

// 앱 공장 통제실 설정값(간단한 key-value). 예: supervisorEnabled = "false" 면 감독 프로그램이 새 일감을 가져가지 않는다.
model FactorySetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("factory_settings")
}

// 공장 앱 단위 레코드. 공장 앱 이름(slug)과 홈페이지 Project 를 잇는다.
// (Project.name 은 제목+id 로 자동 생성되는 값이라 slug 와 같지 않다.)
model FactoryApp {
  appSlug   String   @id
  projectId String?  @unique // 연결된 홈페이지 Project.id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── 출시 (반자동) ──
  releaseAccountId  String? // 배포 계정(FactoryReleaseAccount.id)
  releaseStatus     String    @default("preparing") // preparing | package | review | testing | released
  packageName       String? // Android applicationId (예: com.factory.my_app)
  firstUploadDone   Boolean   @default(false) // 최초 1회 Play Console 직접 업로드를 마쳤는지(이후 API 업로드 가능)
  testingStartedAt  DateTime? // 비공개 테스트 시작일(테스트가 필요한 계정)
  testingDueAt      DateTime? // 완료 예정일(시작 + 14일)
  testingNotifiedAt DateTime? // 완료 예정일 텔레그램 알림을 보낸 시각
  releasePackage    Json? // 출시 준비 일감이 만든 스토어 문구·데이터 보안·콘텐츠 등급·체크리스트·방침 초안
  releasePackageAt  DateTime?
  releasePackageJob String? // 그 패키지를 만든 일감 id
  aab               Json? // { path, size, versionName, versionCode, builtAt } (파일은 PC 에만 있다)
  releaseRemovedAt  DateTime? // 출시 패키지 목록에서 지운 시각. 이후 새 일감이 생기면 다시 보인다
  storeTarget       Boolean   @default(false) // 출시 대상(스토어에 올릴 앱). 출시 패키지 목록에는 이것만 보인다. nextjs·nestjs 는 될 수 없다
  customKeystorePath String? // 앱별 '다른 키 사용': 공용(배포 계정) 키 대신 쓸 업로드 키 경로
  customKeyAlias     String? // 그 키의 별칭
  promoVideoUrl      String? // 홍보 영상 YouTube 링크(사람이 직접 올리고 붙여 넣음). 스토어 자료 업로드 때 Play 등록정보 영상으로
  storeAssets        Json? // 스토어 자료(.factory/store/) 단계별 결과·파일 정보(경로·크기·길이)·올린 이미지 URL·Play 업로드 결과
  appName            String? // 사람이 출시 카드에서 정한 앱 이름(스토어·홈페이지에 보일 이름, 30자). 비우면 스토어 문구 제목 → 홈페이지 프로젝트 제목 → 작업 이름
  keyId              String? // 이 앱이 쓸 키(키 보관함). 없으면 배포 계정 기본 키. customKeystorePath·customKeyAlias 는 예전 값(호환용 사본)
  reviewUrl          String? // 검수 페이지 주소(https 만). 카드에 [검수 페이지 열기]·'검수 대기 N장'(그 호스트의 /api/review-status)
  releaseAccount   FactoryReleaseAccount? @relation(fields: [releaseAccountId], references: [id], onDelete: SetNull)
  key              FactoryKey?            @relation(fields: [keyId], references: [id], onDelete: SetNull)

  @@map("factory_apps")
}

// 스토어 배포 계정 프로필. 서명 키·서비스 계정 키는 PC 파일 경로만 저장한다(값과 비밀번호는 저장하지 않는다).
model FactoryReleaseAccount {
  id                    String       @id @default(cuid())
  label                 String       @unique // "A", "B"
  name                  String // 표시 이름
  requiresTesting       Boolean      @default(false) // 비공개 테스트(12명·14일)가 필요한 계정인지
  developerName         String? // 스토어에 보이는 개발자 이름
  contactEmail          String? // 스토어·개인정보처리방침 연락 이메일
  keystorePath          String? // PC 의 업로드 키(서명 키) 파일 경로
  keyAlias              String? // 키 별칭
  serviceAccountKeyPath String? // PC 의 Play Developer API 서비스 계정 JSON 경로
  developerAccountId    String? // Play Console 개발자 계정 ID(19자리 숫자, 문자열)
  accountType           String? // personal(개인) | organization(조직)
  loginEmail            String? // Play Console 로그인 구글 이메일
  notes                 String?      @db.Text
  defaultKeyId          String? // 기본 키(키 보관함). keystorePath·keyAlias 는 예전 값(호환용 사본)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  apps                  FactoryApp[]
  defaultKey            FactoryKey?  @relation(fields: [defaultKeyId], references: [id], onDelete: SetNull)

  @@map("factory_release_accounts")
}

// 키 보관함: 업로드(서명) 키 항목. PC 파일 경로·별칭만 저장한다(파일 내용·비밀번호는 저장하지 않음. 비밀번호는 FactoryKeyPassword 방식).
// 공용 키는 [새 공용 키 만들기]로만 PC 감독 프로그램이 keytool 로 만든다(파일이 있으면 절대 덮어쓰지 않음).
model FactoryKey {
  id               String                  @id @default(cuid())
  name             String                  @unique // 별명
  kind             String                  @default("shared") // shared(공용 키) | app(기존 앱 키)
  keystorePath     String // PC 의 키 파일 경로(확장자 없어도 됨)
  keyAlias         String                  @default("upload")
  description      String?                 @db.Text
  production       Boolean                 @default(false) // 운영 키(프로덕션 배포에 쓰임): 경로·별칭 변경·삭제 불가
  dname            String? // 공용 키 만들 때 인증서 이름(CN)
  createState      String? // 공용 키 만들기: requested | creating | done | failed (기존 키 등록은 null)
  createTakenAt    DateTime? // PC 가 만들기를 가져간 시각
  checkRequestedAt DateTime? // [조회] 요청 시각(PC 가 가져가면 checkTakenAt)
  checkTakenAt     DateTime?
  check            Json? // PC 에서 확인된 정보(있음·크기·수정 시각·형식·별칭·SHA-1·git 추적·확인 시각)
  lastError        String?                 @db.Text // 마지막 만들기·조회 오류(비밀번호 가림)
  lastErrorAt      DateTime?
  untrackRequestedAt DateTime? // [커밋에서 빼기] 요청 시각(PC 가 가져가면 untrackTakenAt)
  untrackTakenAt     DateTime?
  passwordRef        String? // 비밀번호 이름(RELEASE_KEY_<이 값>_…)에 쓰는 구분값. 경로를 바꿔도 비밀번호가 이어지게 처음 값을 남긴다(없으면 경로+별칭)
  untrack            Json? // [커밋에서 빼기] 결과(커밋 해시 앞 7자리·날짜·메시지 첫 줄, 원격·브랜치 이름, .gitignore 추가 줄, 새 커밋). 파일 내용 없음
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  accounts         FactoryReleaseAccount[]
  apps             FactoryApp[]

  @@map("factory_keys")
}

// 업로드 키 비밀번호 임시 보관. 통제실에서 입력한 값을 암호화해 두었다가, PC 감독 프로그램이 가져가 secrets.env 에 저장하면 sealed 를 비운다.
// 키 단위(경로+별칭)로 구분한다. 값은 어떤 화면·API 응답에도 다시 나오지 않는다(등록됨 표시만).
model FactoryKeyPassword {
  keyRef       String    @id // 경로+별칭으로 만든 구분값
  keystorePath String
  keyAlias     String
  storeName    String // PC secrets.env 의 키 저장소 비밀번호 이름
  keyName      String // PC secrets.env 의 키 비밀번호 이름
  sealed       String?   @db.Text // 암호화한 값. PC 가 가져가면 null
  registeredAt DateTime  @default(now())
  deliveredAt  DateTime? // PC 에 저장된 시각

  @@map("factory_key_passwords")
}

// 통제실에서 입력한 외부 서비스 키(환경변수). 값은 PC secrets.env 에만 두고, 서버는 PC 가 가져갈 때까지만 암호문으로 들고 있는다.
// 같은 이름을 다시 등록·삭제하면 version 이 올라가고, PC 는 받은 version 으로만 확인(ack)한다(그 사이 바뀐 값은 남는다).
model FactorySecretEntry {
  name        String    @id // 예: PIXELLAB_TOKEN
  description String    @default("")
  sealed      String?   @db.Text // 암호화한 값. PC 가 저장했다고 확인하면 null
  version     Int       @default(1)
  status      String    @default("pending") // pending(서버 대기) | stored(PC 저장 완료) | delete_pending(삭제 대기)
  storedAt    DateTime? // PC 에 저장된 시각
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("factory_secret_entries")
}

// ── 공장 정비(공장 자체를 고치는 대화형 스레드). 앱 일감(FactoryJob)과 따로 둔다 ──
// 스레드 하나 = 정비 대화 하나. 사용자 지시마다 감독 프로그램이 정비 전용 체크아웃에서 같은 Claude 세션을 이어(--resume) 처리한다.
// 결과는 검사를 통과해야 GitHub main 에 올라가고, 서버 코드가 바뀌었으면 사람이 [배포]를 눌러야 서버에 반영된다.
model FactoryMaintenance {
  id                String                      @id @default(cuid())
  title             String
  status            String                      @default("open") // open | closed
  sessionId         String? // Claude 세션 id(이어서 하기)
  codexSessionId    String? // Codex 세션 id. Claude sessionId 와 섞지 않는다
  pushedCommit      String? // 마지막으로 GitHub 에 올린 커밋
  needsDeploy       Boolean                     @default(false) // 서버 코드가 바뀌어 배포가 필요한지
  deployCommit      String? // 배포하라고 한 커밋
  deployRequestedAt DateTime?
  deployStartedAt   DateTime?
  deployedAt        DateTime?
  deployResult      String?                     @db.Text
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  messages          FactoryMaintenanceMessage[]
  deploys           FactoryDeploy[]

  @@index([updatedAt])
  @@map("factory_maintenance")
}

model FactoryMaintenanceMessage {
  id            String             @id @default(cuid())
  maintenanceId String
  role          String // user(지시) | assistant(결과) | log | system
  aiEngine      String             @default("claude") // 지시마다 선택한 실행 AI
  aiModel       String? // Claude Code --model 별칭(승인·보낼 때 고름). NULL = 기본 설정. assistant 결과에는 실행한 모델을 복사
  text          String             @db.Text
  status        String? // user 지시: awaiting_approval | queued | running | done | failed | cancelled
  source        String? // 통제실 | 채팅
  createdAt     DateTime           @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  heartbeatAt   DateTime?
  pushedCommit  String? // user 지시: 이 지시가 GitHub 에 올린 커밋
  needsDeploy   Boolean            @default(false) // user 지시: 서버 코드가 바뀌었는지
  deployedAt    DateTime? // user 지시: 이 지시의 커밋이 포함된 배포가 끝난 시각
  turnId        String? // log: 이 로그를 남긴 지시(user 메시지) id. 예전 로그는 NULL
  handoff       Json? // assistant 결과: 이 지시가 끝날 때 남긴 인계 기록 항목(읽기 전용 표시용, lib/factory/handoff.ts)
  maintenance   FactoryMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([maintenanceId, createdAt])
  @@index([status])
  @@map("factory_maintenance_messages")
}

// 서버 배포 이력. [배포]를 누를 때마다 한 줄. (FactoryMaintenance 의 deploy* 열은 "마지막 배포" 상태로 그대로 쓴다)
model FactoryDeploy {
  id            String             @id @default(cuid())
  maintenanceId String
  commit        String
  via           String? // 통제실 | 텔레그램
  requestedAt   DateTime           @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  ok            Boolean? // null = 아직 결과 없음
  result        String?            @db.Text
  items         String?            @db.Text // 이 배포에 포함된 지시 목록 JSON [{ turnId, threadId, title, commit }]
  maintenance   FactoryMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([requestedAt])
  @@index([maintenanceId, requestedAt])
  @@map("factory_deploys")
}

// 감독 프로그램 업데이트 이력. 감독 프로그램이 /next 로 알려 주는 커밋·소식이 바뀔 때마다 한 줄.
model FactorySupervisorEvent {
  id         Int      @id @default(autoincrement())
  at         DateTime @default(now())
  fromCommit String? // 커밋이 바뀌었을 때 이전 커밋
  commit     String // 그때의 커밋
  subject    String? // 그 커밋의 메시지 첫 줄(감독 프로그램이 보낸 것)
  note       String? // 최근 자동 업데이트 소식

  @@index([at])
  @@map("factory_supervisor_events")
}

// 출시 검토용 홍보 영상(관리자만 재생). 감독 프로그램이 8MB 조각으로 올리고, 결정 뒤 또는 7일 뒤 지운다(임시).
model FactoryReviewVideo {
  jobId      String   @id
  appSlug    String
  size       Int // 전체 바이트
  chunkCount Int
  received   Int      @default(0) // 받은 조각 수
  complete   Boolean  @default(false)
  createdAt  DateTime @default(now())
  expiresAt  DateTime // 만든 뒤 7일
  chunks     FactoryReviewVideoChunk[]

  @@index([expiresAt])
  @@map("factory_review_videos")
}

model FactoryReviewVideoChunk {
  jobId String
  idx   Int
  data  Bytes
  video FactoryReviewVideo @relation(fields: [jobId], references: [jobId], onDelete: Cascade)

  @@id([jobId, idx])
  @@map("factory_review_video_chunks")
}

// 출시 패키지 '시험용 APK': 감독 프로그램이 서명된 release APK 를 조각(chunkSize)으로 올리고, 통제실(관리자만)이 내려받는다.
// 공개 업로드 서버가 아니라 DB 에 둔다(관리자 전용 주소·삭제 가능). 앱당 다 받은 것 최근 5개만 남긴다. 키·비밀번호는 없다.
model FactoryTestApk {
  id           String    @id @default(cuid())
  appSlug      String
  jobId        String // 만든 출시 일감(releaseKind=apk)
  fileName     String // 서버가 정한 내려받기 이름(영문·숫자·._- 만)
  size         Int // 전체 바이트
  sha256       String // 감독 프로그램이 잰 값. 다 받으면 서버가 다시 재서 맞아야 complete
  versionName  String?
  versionCode  Int?
  builtAt      DateTime?
  gitCommit    String? // 앱 폴더 커밋(짧은 해시, 고친 채면 +dirty)
  signerSha256 String? // 서명 인증서 SHA-256 지문(공개 정보)
  keyLabel     String? // 서명에 쓴 키 이름(표시용, 값 없음)
  abi          String? // APK 에 든 CPU 종류: arm64-v8a(휴대폰용) | universal(모든 ABI) 등. 예전 행은 null
  chunkCount   Int
  chunkSize    Int       @default(8388608) // 이 APK 의 조각 크기(마지막 조각만 작음). 예전 행은 8MB
  received     Int       @default(0)
  complete     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  chunks       FactoryTestApkChunk[]

  @@index([appSlug, createdAt])
  @@map("factory_test_apks")
}

model FactoryTestApkChunk {
  apkId String
  idx   Int
  data  Bytes
  apk   FactoryTestApk @relation(fields: [apkId], references: [id], onDelete: Cascade)

  @@id([apkId, idx])
  @@map("factory_test_apk_chunks")
}

// Studio 접근 키(서버1 nginx auth_request 가 /api/studio-auth/verify 로 확인). 앱 이름별, 유효한 키는 앱당 1개(revokedAt 없음).
// 키 원문은 저장하지 않는다. keyHash = HMAC-SHA256(STUDIO_KEY_PEPPER, 키) hex. lib/studio/access.ts
model StudioAccessKey {
  id         String    @id @default(cuid())
  app        String // 앱 이름(소문자·숫자·하이픈 3~40자)
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  createdBy  String // 발급한 관리자(이메일 또는 id)
  revokedAt  DateTime? // 있으면 무효
  lastUsedAt DateTime? // 마지막 검증 성공(1분에 한 번 이하로 기록)

  @@index([app, revokedAt])
  @@map("studio_access_keys")
}

// 통제실 '장비 상태': 서버1·서버2·메인PC 가 1분마다 보내는 최신 값(장비 하나에 1행). 숫자만(호스트 이름·IP·프로세스 없음)
model DeviceStat {
  device     String   @id // server1 | server2 | main-pc
  data       Json // { cpuPct, ram, gpu, disks, containers? } (검증한 값만)
  measuredAt DateTime // 장비가 읽은 시각
  receivedAt DateTime // 서버가 받은 시각(오래된 값·끊김 판정 기준)

  @@map("device_stats")
}

// 장비 상태 짧은 이력: 5분에 한 점, 24시간 지나면 지운다
model DeviceStatSample {
  id      Int      @id @default(autoincrement())
  device  String
  at      DateTime
  cpuPct  Float?
  ramPct  Float?
  gpuPct  Float?
  diskPct Float? // 가장 많이 찬 디스크

  @@index([device, at])
  @@map("device_stat_samples")
}

// Studio 요청 입구(POST /api/studio-requests) 감사 기록. 키 원문·해시는 저장하지 않고 키 id 만 둔다(인증 실패는 키 id 없음).
model StudioRequestLog {
  id        String   @id @default(cuid())
  keyId     String? // StudioAccessKey.id
  kind      String // regen | layout | ?
  appSlug   String
  result    String // created | invalid | conflict | rate_limited | error
  jobId     String?
  createdAt DateTime @default(now())

  @@index([keyId, createdAt])
  @@map("studio_request_logs")
}

// ───────── 소설 공장 (글 제작 공장) ─────────
// 화 하나를 PC 실행기가 기획 → 집필 → 검수 → 정리 순서로 만들고, 통제실에서 사람이 읽고 승인하면 예약 발행한다.
// 소설 바이블(인물·세계관·떡밥 장부)의 원본은 PC 파일이라 DB 에 넣지 않는다. lib/novel/
model NovelWork {
  id              String    @id @default(cuid())
  slug            String    @unique // APP_SLUG_RE 형식
  title           String
  genre           String?
  logline         String?   @db.Text
  setupSummary    String?   @db.Text // 컨셉·인물·세계관·아크 요약(마크다운). 설정 승인 화면에 보여 줌
  status          String    @default("setup") // setup | active | finished | dropped
  setupApprovedAt DateTime?
  approvalMode    String    @default("every") // every | batch5 | auto
  publishPerDay   Int       @default(1) // 하루 예약 발행 화수 (1~24)
  paused          Boolean   @default(false) // 실행기가 sync 로 읽는 일시정지 스위치
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  episodes NovelEpisode[]
  logs     NovelLog[]

  @@map("novel_works")
}

// 공개 여부는 저장하지 않는다: status = approved 이고 publishAt <= 지금이면 공개(파생값)
model NovelEpisode {
  id           String    @id @default(cuid())
  workId       String
  number       Int
  title        String?
  body         String?   @db.Text // 최종 후보 본문
  summary      String?   @db.Text // 정리자 요약 (앞 화 요약으로 쓰임)
  status       String    @default("planned") // planned | drafting | checking | revising | pending_approval | approved | held
  attempts     Int       @default(0)
  checkResult  Json? // { pass: boolean, issues: [{ type, detail }] }
  tokens       Json? // 역할별 { model, in, out }
  revisionNote String?   @db.Text // 사람의 수정 요청 메모
  approvedAt   DateTime?
  publishAt    DateTime? // 예약 발행 시각. approved 이고 publishAt <= now 이면 공개
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  work NovelWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, number])
  @@index([workId, status])
  @@index([workId, publishAt])
  @@map("novel_episodes")
}

model NovelLog {
  id            Int      @id @default(autoincrement())
  workId        String
  episodeNumber Int?
  level         String   @default("info") // info | warn | error
  message       String // 2000자 이내
  at            DateTime @default(now())

  work NovelWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId, at])
  @@map("novel_logs")
}

// 프로젝트(앱 이름)별 도구 설정(pixel-art 의 settings 인자). 현재 값은 settings(JSON 글자), 바뀔 때마다 history 에 한 줄씩 쌓는다.
model FactoryProjectToolSetting {
  appSlug   String   @id
  version   Int      @default(1)
  settings  String
  updatedAt DateTime @default(now())
  updatedBy String   @default("")

  @@map("factory_project_tool_settings")
}

model FactoryProjectToolSettingHistory {
  id        Int      @id @default(autoincrement())
  appSlug   String
  version   Int
  settings  String
  note      String   @default("")
  createdAt DateTime @default(now())
  createdBy String   @default("")

  @@index([appSlug, version])
  @@map("factory_project_tool_setting_history")
}

// 도트 그림 저장소(pixel-art 결과): AI 가 만든 그림은 '후보' → 관리자가 스튜디오에서 보고 승인/반려 → 승인된 것만 이후 참고 그림으로 자동 전달된다.
model FactoryArt {
  id         String    @id @default(cuid())
  appSlug    String // 프로젝트(앱 이름)
  subject    String // 대상 이름(별칭 묶음은 프로젝트 도구 설정 aliases)
  kind       String // image-prop | image-scene | motion-game | motion-clip
  status     String    @default("candidate") // candidate(후보) | approved(승인) | rejected(반려)
  url        String // 업로드 서버 주소(추측 불가 파일 이름)
  method     String    @default("") // 만든 방식(codex | claude | pixellab | manual …)
  summary    String    @default("") // result.json 요약 JSON(steps·refs·cost). 프롬프트·키 없음
  jobId      String? // 만든 일감 id (손으로 올린 처음 값은 없음)
  srcKey     String    @unique // 같은 파일 중복 등록 방지: <jobId>:<경로> 또는 seed:<이름>
  createdAt  DateTime  @default(now())
  decidedBy  String    @default("") // 승인·반려한 사람
  decidedAt  DateTime? // 승인·반려 시각
  note       String    @default("")
  cardId     String? // 이 그림을 만든 결과물 카드(factory_cards.id). 카드 없이 만든 그림은 NULL
  cardVersion Int? // 그때의 카드 판 번호

  @@index([appSlug, status])
  @@index([cardId])
  @@map("factory_arts")
}

// 감독 프로그램 재전송 중복 방지. 배포 중에 쌓였다 다시 보내는 보고·로그·스크린샷에 붙은 요청 번호(X-Request-Id)를
// 처리한 뒤 남겨 두고, 같은 번호가 또 오면 다시 처리하지 않는다. 하루 지난 줄은 정리한다.
model FactoryRequestSeen {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("factory_request_seen")
}

// 앱별 배포·저장소 연결 기록(사람이 입력하는 값 + 현황 조사 초기값). 감독 프로그램이 읽어 보낸 git 원격·컨테이너 목록은
// factory_settings 의 projectLinksReport 에 따로 있다. 기록만 하고 통일은 하지 않는다(lib/factory/projectLinks.ts).
model FactoryAppConnection {
  appSlug       String   @id // 앱 이름 = 앱 폴더 이름
  folder        String? // 앱 폴더 이름이 appSlug 와 다를 때만
  stack         String?
  defaultBranch String?
  remotes       Json? // 초기값 [{ name, host, path, purpose }]. 감독 프로그램 보고가 있으면 보고가 우선
  deployServer  String? // serverpc | serverpc2 | none
  deployMethod  String? // 예: prod push / origin push / server push / 수동
  domain        String?
  containerName String? // 서버 도커 컨테이너 이름
  services      Json? // 연결된 서비스 컨테이너 이름 목록
  notes         String?
  exportKind    String? // 승인 그림을 내보낼 곳(2-2): folder(앱 폴더 경로) | upload(서비스 업로드) | null(안 정함)
  exportPath    String? // exportKind=folder 일 때 앱 폴더 안 상대 경로
  studioBatch   Boolean  @default(false) // 스튜디오 기능: 배치
  studioService Boolean  @default(false) // 스튜디오 기능: 서비스 운영
  layoutConfig  Json? // 배치 설정(3-4): 칸 크기·맵 형태·층·그림 종류·내보내기 형식과 곳. null 이면 정하지 않음
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("factory_app_connections")
}

// 결과물 카드(2-2): 프로젝트마다 "이런 결과물을 이렇게 만든다"를 이름 붙여 저장한 것. 일감은 카드 이름만 부른다.
// 키는 저장하지 않는다(도구 설명서의 방법 → 키가 자동으로 정해진다). settings 는 pixel-art 프로젝트 설정(JSON 글자) 중 카드가 직접 갖는 묶음.
model FactoryCard {
  id          String   @id
  appSlug     String
  name        String // 한국어 카드 이름(프로젝트 안에서 겹치지 않음)
  description String   @default("")
  tool        String   @default("pixel-art")
  method      String   @default("") // 도구 설명서의 방법 id. 비면 설정의 기본 방식
  options     Json     @default("{}") // 설명서 입력 항목 값 { kind, size, frames, preset, background … }
  refRules    Json     @default("{}") // 참고 규칙 { pinDefault, defaultArtId, sameSubject, sameKind, maxRefs }
  settings    String   @default("") // 카드가 갖는 설정 묶음(spec·style·motion·cost·aliases …)의 JSON 글자. 비면 없음
  enabled     Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  updatedBy   String   @default("")

  @@unique([appSlug, name])
  @@index([appSlug])
  @@map("factory_cards")
}

model FactoryCardHistory {
  id        Int      @id @default(autoincrement())
  cardId    String
  appSlug   String
  version   Int
  source    String   @default("통제실") // 누가: 통제실 | 채팅 | 정비
  who       String   @default("")
  note      String   @default("")
  snapshot  Json // 그 판의 카드 내용(이름·설명·도구·방법·옵션·참고 규칙·설정)
  createdAt DateTime @default(now())

  @@index([cardId, version])
  @@map("factory_card_history")
}

// 스튜디오 운영(3-3): 승인 그림을 내보낸 기록(그림마다 여러 줄 가능). kind = folder(앱 폴더에 넣기 일감) | upload(서비스 업로드).
// status = requested(일감 등록됨) | done(보냄) | failed | unsupported(서비스 업로드 미지원)
model FactoryArtExport {
  id        String   @id
  artId     String
  appSlug   String
  kind      String
  status    String
  jobId     String? // 앱 수정 일감 id (folder)
  dest      String   @default("") // 보낸 곳: 앱 폴더 안 경로/파일 이름 또는 서비스 이름
  note      String   @default("")
  who       String   @default("")
  createdAt DateTime @default(now())

  @@index([artId])
  @@index([appSlug, createdAt])
  @@map("factory_art_exports")
}

// 스튜디오 운영(3-3): 카드별 자동 생성 일정(기본 꺼짐). 정해진 시각(한국 시간 hour 시)이 되면 도구 일감을 만든다. 하루 한 번(lastRunKey = 날짜).
model FactoryGenSchedule {
  id          String    @id
  appSlug     String
  cardId      String
  enabled     Boolean   @default(false)
  hour        Int       @default(9) // 한국 시간 0~23
  count       Int       @default(1) // 대상마다 장 수
  subjects    String    @default("") // 대상 이름(쉼표)
  extra       String    @default("")
  lastRunKey  String    @default("") // 마지막으로 만든 날짜(KST YYYY-MM-DD)
  lastRunAt   DateTime?
  lastJobId   String?
  lastMessage String    @default("")
  updatedAt   DateTime  @default(now())
  updatedBy   String    @default("")

  @@unique([appSlug, cardId])
  @@map("factory_gen_schedules")
}

// 스튜디오 배치(3-4): 프로젝트마다 저장할 때마다 한 줄씩 쌓는 판 이력. version 은 프로젝트 안의 판 번호(1부터). board 는 JSON 글자.
// source = editor(편집기 저장) | import(서비스·파일에서 불러옴) | restore(옛 판으로 되돌림). export* = 이 판을 내보낸 기록(요청·결과).
model FactoryLayoutBoard {
  id           String    @id
  appSlug      String
  version      Int
  board        String
  itemCount    Int       @default(0)
  source       String    @default("editor")
  note         String    @default("")
  who          String    @default("")
  exportStatus String    @default("") // requested | done | failed | unsupported | 빈 글자(안 보냄)
  exportJobId  String? // 앱 수정 일감 id (앱 폴더로 보낼 때)
  exportDest   String    @default("")
  exportNote   String    @default("")
  exportedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([appSlug, version])
  @@map("factory_layout_boards")
}
