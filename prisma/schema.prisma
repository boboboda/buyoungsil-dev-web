generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String?   @default("user")
  // "모든 기기에서 로그아웃"을 누를 때마다 1씩 올라간다. 쿠키 안의 값(sv)과 다르면 그 로그인은 무효.
  sessionVersion Int      @default(0)
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DevelopNote {
  id              String   @id @default(cuid())
  noteId          Int      @unique
  title           String?
  content         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mainCategory    String?
  subCategory     Json?
  level           String   @default("BEGINNER")
  isPublished     Boolean  @default(false)
  metaDescription String?
  metaTitle       String?
  relatedNoteIds  Int[]    @default([])

  @@index([isPublished])
  @@index([mainCategory])
  @@map("developNote")
}


model ProjectTag {
  id        String  @id @default(cuid())
  name      String
  color     String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_tags")
}

model ProjectLog {
  id        String   @id @default(cuid())
  projectId String
  title     String
  content   String
  logType   String
  noteId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([noteId])
  @@map("project_logs")
}

model Revenue {
  id        String   @id @default(cuid())
  projectId String
  month     String
  adsense   Int      @default(0)
  inapp     Int      @default(0)
  total     Int      @default(0)
  dau       Int?
  mau       Int?
  downloads Int?
  retention Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month])
  @@index([month])
  @@map("revenues")
}

model Story {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String
  excerpt         String?
  category        String
  tags            String[]
  isPublished     Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("stories")
}

model Post {
  id         String    @id @default(uuid())
  listNumber Int
  writer     String
  title      String
  content    String
  createdAt  DateTime  @default(now()) @map("created_at")
  appName    String
  postType   String
  email      String
  comments   Comment[]

  @@index([appName, postType])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  writer    String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  postId    String   @map("post_id")
  email     String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  replies   Reply[]

  @@map("comments")
}

model Reply {
  id        String   @id @default(uuid())
  writer    String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  commentId String   @map("comment_id")
  email     String
  mentionTo String?
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("replies")
}

model App {
  id          String   @id @default(cuid())
  name        String   @unique
  title       String
  description String
  appLink     String
  coverImage  String?
  databaseId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        Tag[]
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String
  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, name])
}

model DailyVisitorCount {
  id    String @id @default(cuid())
  date  String @unique @map("visit_date")
  count Int    @default(0)

  @@map("daily_visitor_counts")
}

model TotalVisitorCount {
  id         String @id @default("singleton")
  totalCount Int    @default(0) @map("total_count")

  @@map("total_visitor_counts")
}





model Project {
  id          String       @id @default(cuid())
  name        String       @unique
  title       String
  description String       @db.Text
  coverImage  String?
  appLink     String?
  
  // 🔥 플랫폼 (상위 분류)
  platform    String       // "mobile" | "web" | "backend"
  
  // 🔥 상태 관리
  status      String       @default("in-progress")
  // "released" | "in-progress" | "backend"

    // 🔥 기술 스택 (노트 연결용) - 배열로 저장
  techStack   String[]     @default([])

  
  progress    Int          @default(0)
  databaseId  String?

  // 🔥 개인정보처리방침 (마크다운 본문 + 시행일)
  privacyPolicy    String?   @db.Text
  privacyUpdatedAt DateTime?

  tags        ProjectTag[]
  logs        ProjectLog[]
  revenues    Revenue[]
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("projects")
  @@index([platform])
  @@index([status])
}

model NoteCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  
  // 🔥 플랫폼 (상위 분류)
  platform    String?  // "mobile" | "web" | "backend" | null (basics)

  // 🔥 카드 표시 / SEO (관리자 화면에서 수정)
  gradient        String?  // 색상 프리셋 키 (lib/note/categoryUtils.ts)
  imageUrl        String?  // 카드 대표 이미지 (없으면 아이콘 표시)
  tags            String[] @default([])
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[] @default([])
  
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("note_categories")
  @@index([platform])
  @@index([isPublished])
}


// 🔥 서브 카테고리 (메인 카테고리별로 관리)
model NoteSubCategory {
  id           String   @id @default(cuid())
  mainCategory String   // NoteCategory 슬러그 ("flutter", "react" ...)
  name         String
  order        Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([mainCategory, name])
  @@index([mainCategory])
  @@map("note_sub_categories")
}


model WorkRequest {
  id          String   @id @default(cuid())
  
  // 신청자 정보
  name        String
  email       String
  company     String?
  phone       String?
  
  // 프로젝트 정보
  projectType String   // "mobile" | "web" | "backend" | "consulting"
  budget      String   // "1000만원 이하" | "1000-3000만원" | "3000-5000만원" | "5000만원 이상"
  timeline    String   // "1개월" | "2-3개월" | "3-6개월" | "6개월 이상"
  
  // 상세 내용
  title       String
  description String   @db.Text
  requirements String?  @db.Text
  reference   String?  // 참고 URL
  
  // 상태 관리
  status      String   @default("pending") 
  // "pending" | "reviewing" | "accepted" | "rejected" | "completed"
  
  // 관리자 메모
  adminNote   String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("work_requests")
  @@index([status])
  @@index([createdAt])


  
}

// ===== prisma/schema.prisma 맨 아래에 추가 =====

// 분석 대상 앱 목록과 수집 키
model AnalyticsApp {
  id        String   @id @default(cuid())
  appId     String   @unique // 사람이 읽는 앱 이름 (예: "exchange-rate")
  name      String
  ingestKey String   @unique // 앱이 이벤트를 보낼 때 헤더로 보내는 키
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  events       AnalyticsEvent[]
  installs     AnalyticsInstall[]
  dailyActives DailyActiveInstall[]

  @@map("analytics_apps")
}

// 원본 이벤트 (90일 보관 예정)
model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  appId      String
  eventId    String // 앱이 만든 UUID. 재전송해도 한 번만 저장
  installId  String
  sessionId  String?
  name       String
  params     Json?
  appVersion String?
  platform   String?
  osVersion  String?
  occurredAt DateTime
  receivedAt DateTime @default(now())

  app AnalyticsApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, eventId])
  @@index([appId, occurredAt])
  @@index([appId, name, occurredAt])
  @@index([appId, installId, occurredAt])
  @@map("analytics_events")
}

// 설치(기기)별 첫 접속, 마지막 접속, 버전
model AnalyticsInstall {
  appId       String
  installId   String
  firstSeenAt DateTime
  lastSeenAt  DateTime
  appVersion  String?
  platform    String?
  osVersion   String?

  app AnalyticsApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, installId])
  @@index([appId, lastSeenAt])
  @@index([appId, firstSeenAt])
  @@map("analytics_installs")
}

// 하루에 한 번이라도 앱을 연 설치 (한국 시간 기준 날짜)
model DailyActiveInstall {
  appId     String
  date      String // yyyy-MM-dd (KST)
  installId String

  app AnalyticsApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, date, installId])
  @@index([appId, date])
  @@map("daily_active_installs")
}

// ========================================
// 특수교육 도구함(edu) 게시판
// edu 사이트 서버가 /api/edu/* 로만 접근한다. 기존 posts 테이블과는 분리.
// ========================================
model EduPost {
  id           String   @id @default(cuid())
  board        String // "request" (앱·도구 요청, 공개) | "contact" (문의, 비밀글)
  nickname     String
  passwordHash String // scrypt$salt$hash (원문 비밀번호는 저장하지 않음)
  title        String
  content      String   @db.Text
  isSecret     Boolean  @default(false)
  status       String   @default("open") // "open" | "reviewing" | "planned" | "done"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  replies EduReply[]

  @@index([board, createdAt])
  @@map("edu_posts")
}

model EduReply {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  post EduPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("edu_replies")
}

// 초안함: Claude 스킬이 보낸 글 초안. 관리자가 분류를 정해 개발노트/스토리(비공개)로 보내거나 버린다.
model Draft {
  id                  String    @id @default(cuid())
  title               String
  markdown            String    // 본문(마크다운). 보낼 때 Lexical 로 변환
  recommendedTarget   String?   // "note" | "story" (스킬이 추천한 구분)
  recommendedSection  String?   // 추천 섹션 (NoteCategory.slug 또는 이름)
  recommendedCategory String?   // 추천 카테고리 (세부 카테고리 또는 스토리 분류)
  level               String    @default("BEGINNER")
  tags                String[]  @default([])
  source              String?   // 어느 대화/프로젝트에서 왔는지 (선택)
  status              String    @default("pending") // pending | sent | discarded
  sentType            String?   // "note" | "story"
  sentRef             String?   // 보낸 노트의 noteId 또는 스토리 id
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("drafts")
}

// ========================================
// Claude Code 작업 현황
// 사용자 PC의 Claude Code 훅이 /api/claude-status 로 보낸 이벤트를 저장한다.
// 프롬프트·코드 내용은 받지도 저장하지도 않는다. (세션 ID, 폴더 이름, 기기 이름, 도구 이름, 토큰 수치만)
// ========================================

// 세션 하나의 현재 상태. 같은 세션의 이벤트가 오면 이 행을 갱신한다.
model ClaudeSession {
  id                String   @id // Claude Code 세션 ID
  device            String // 기기 이름 (예: homeserver, laptop)
  project           String // 작업 폴더 이름 (cwd 의 마지막 폴더)
  status            String   @default("idle") // working | waiting | idle | ended
  lastEvent         String
  lastTool          String?
  startedAt         DateTime
  lastEventAt       DateTime
  // 세션 누적 토큰. 훅 스크립트가 transcript 에서 합산해 보낸 가장 최근 값
  inputTokens       BigInt   @default(0)
  outputTokens      BigInt   @default(0)
  cacheCreateTokens BigInt   @default(0)
  cacheReadTokens   BigInt   @default(0)

  events ClaudeEvent[]

  @@index([lastEventAt])
  @@map("claude_sessions")
}

// 의미 있는 이벤트만 쌓는다. (도구 호출 이벤트는 세션 행만 갱신하고 여기엔 쌓지 않는다)
// 토큰 증가분(…Delta)은 "최근 5시간 사용량" 추정에 쓴다.
model ClaudeEvent {
  id               Int      @id @default(autoincrement())
  sessionId        String
  event            String
  at               DateTime
  inputDelta       Int      @default(0)
  outputDelta      Int      @default(0)
  cacheCreateDelta Int      @default(0)
  cacheReadDelta   Int      @default(0)

  session ClaudeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
  @@index([at])
  @@map("claude_events")
}

// 하루(한국 시간) × 기기 × 프로젝트별 토큰 사용량 합계
model ClaudeDailyUsage {
  date              String // yyyy-MM-dd (KST)
  device            String
  project           String
  inputTokens       BigInt @default(0)
  outputTokens      BigInt @default(0)
  cacheCreateTokens BigInt @default(0)
  cacheReadTokens   BigInt @default(0)

  @@id([date, device, project])
  @@index([date])
  @@map("claude_daily_usage")
}

// ─────────────────────────────────────────────
// 앱 공장 (factory): 기획서를 지시로 쌓고, 내 PC 의 감독 프로그램이 가져가 앱을 만든다.
// 기존 모델과는 연결하지 않는다. (ClaudeSession 과는 appSlug = project 이름으로만 맞춘다)
// ─────────────────────────────────────────────

// 지시 대기열. 앱 하나 = 활성 지시 하나.
model FactoryJob {
  id              String    @id @default(cuid())
  appSlug         String // 앱 폴더 이름(영문 소문자·숫자·하이픈). ClaudeSession.project 와 같다.
  title           String // 표시용 앱 이름
  kind            String    @default("new") // new | revision (수정 지시)
  parentJobId     String? // 수정 지시가 이어받는 이전 지시
  planMarkdown    String // 확정된 기획서 본문(수정 지시는 고칠 내용만)
  planHash        String // 기획서 sha256. 같은 기획서 중복 등록 감지
  stack           String    @default("flutter") // 앱 템플릿 종류
  requiredSecrets String[]  @default([]) // 키 이름만. 값은 저장하지 않는다.
  priority        Int       @default(0)
  status          String    @default("pending") // pending | approved | running | done | failed | cancelled
  phase           String? // 워커가 보고하는 현재 단계(scaffold, build, screenshots 등)
  summary         String? // 완료 요약
  failReason      String?
  attempts        Int       @default(0)
  maxAttempts     Int       @default(2)
  workerId        String? // 가져간 감독 프로그램 이름
  leaseUntil      DateTime? // running 상태의 임대 만료 시각
  source          String? // 어느 기획 대화에서 왔는지(선택)
  releaseKind     String? // 출시 일감 종류: first(첫 출시) | store(스토어 자료 수정) | project(프로젝트 업데이트). NULL 은 예전 일감(first)
  failStage       String? // 실패한 단계(key, build, sign, upload, homepage, store 등)
  resumeFrom      String? // 재시도 때 이 단계부터 다시
  resumeNote      String? // 재시도 때 넘기는 이전 실패 이유(마스킹됨)
  overwriteProject Boolean  @default(false) // 출시 일감(store/project): 홈페이지 프로젝트의 기존 값도 덮어쓰기(개인정보처리방침 제외)
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  updatedAt       DateTime  @updatedAt

  images FactoryJobImage[]
  logs   FactoryJobLog[]

  @@index([status, priority, createdAt])
  @@index([appSlug])
  @@map("factory_jobs")
}

model FactoryJobImage {
  id        String     @id @default(cuid())
  jobId     String
  label     String // 화면 이름(home, result 등)
  url       String // 업로드 서버가 돌려준 전체 URL
  createdAt DateTime   @default(now())
  job       FactoryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("factory_job_images")
}

model FactoryJobLog {
  id      Int        @id @default(autoincrement())
  jobId   String
  at      DateTime   @default(now())
  level   String     @default("info") // info | warn | error
  message String // 2000자 이내
  job     FactoryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, at])
  @@map("factory_job_logs")
}

// 키 이름 카탈로그. 값은 PC 의 마스터 파일에만 있다.
model FactorySecretName {
  name        String   @id // 예: PIXELLAB_TOKEN
  description String // 어디에 쓰는 키인지
  createdAt   DateTime @default(now())

  @@map("factory_secret_names")
}

// 앱 공장 작업 PC(감독 프로그램)용 접속 토큰. 홈페이지 통제실에서 발급하고, 원문은 발급 때 한 번만 보여 준다.
model FactoryWorkerToken {
  id         String    @id @default(cuid())
  name       String // 기기 이름(예: mainpc). 감독 프로그램의 worker 이름과 같게 쓴다.
  tokenHash  String    @unique // 토큰 sha256(hex). 원문은 저장하지 않는다.
  prefix     String // 목록에서 구분하려고 보여 주는 앞 8자
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // 마지막으로 접속한 시각

  @@map("factory_worker_tokens")
}

// 앱 공장 통제실 설정값(간단한 key-value). 예: supervisorEnabled = "false" 면 감독 프로그램이 새 일감을 가져가지 않는다.
model FactorySetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("factory_settings")
}

// 공장 앱 단위 레코드. 공장 앱 이름(slug)과 홈페이지 Project 를 잇는다.
// (Project.name 은 제목+id 로 자동 생성되는 값이라 slug 와 같지 않다.)
model FactoryApp {
  appSlug   String   @id
  projectId String?  @unique // 연결된 홈페이지 Project.id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── 출시 (반자동) ──
  releaseAccountId  String? // 배포 계정(FactoryReleaseAccount.id)
  releaseStatus     String    @default("preparing") // preparing | package | review | testing | released
  packageName       String? // Android applicationId (예: com.factory.my_app)
  firstUploadDone   Boolean   @default(false) // 최초 1회 Play Console 직접 업로드를 마쳤는지(이후 API 업로드 가능)
  testingStartedAt  DateTime? // 비공개 테스트 시작일(테스트가 필요한 계정)
  testingDueAt      DateTime? // 완료 예정일(시작 + 14일)
  testingNotifiedAt DateTime? // 완료 예정일 텔레그램 알림을 보낸 시각
  releasePackage    Json? // 출시 준비 일감이 만든 스토어 문구·데이터 보안·콘텐츠 등급·체크리스트·방침 초안
  releasePackageAt  DateTime?
  releasePackageJob String? // 그 패키지를 만든 일감 id
  aab               Json? // { path, size, versionName, versionCode, builtAt } (파일은 PC 에만 있다)
  releaseRemovedAt  DateTime? // 출시 패키지 목록에서 지운 시각. 이후 새 일감이 생기면 다시 보인다
  customKeystorePath String? // 앱별 '다른 키 사용': 공용(배포 계정) 키 대신 쓸 업로드 키 경로
  customKeyAlias     String? // 그 키의 별칭
  promoVideoUrl      String? // 홍보 영상 YouTube 링크(사람이 직접 올리고 붙여 넣음). 스토어 자료 업로드 때 Play 등록정보 영상으로
  storeAssets        Json? // 스토어 자료(.factory/store/) 단계별 결과·파일 정보(경로·크기·길이)·올린 이미지 URL·Play 업로드 결과
  releaseAccount   FactoryReleaseAccount? @relation(fields: [releaseAccountId], references: [id], onDelete: SetNull)

  @@map("factory_apps")
}

// 스토어 배포 계정 프로필. 서명 키·서비스 계정 키는 PC 파일 경로만 저장한다(값과 비밀번호는 저장하지 않는다).
model FactoryReleaseAccount {
  id                    String       @id @default(cuid())
  label                 String       @unique // "A", "B"
  name                  String // 표시 이름
  requiresTesting       Boolean      @default(false) // 비공개 테스트(12명·14일)가 필요한 계정인지
  developerName         String? // 스토어에 보이는 개발자 이름
  contactEmail          String? // 스토어·개인정보처리방침 연락 이메일
  keystorePath          String? // PC 의 업로드 키(서명 키) 파일 경로
  keyAlias              String? // 키 별칭
  serviceAccountKeyPath String? // PC 의 Play Developer API 서비스 계정 JSON 경로
  developerAccountId    String? // Play Console 개발자 계정 ID(19자리 숫자, 문자열)
  accountType           String? // personal(개인) | organization(조직)
  loginEmail            String? // Play Console 로그인 구글 이메일
  notes                 String?      @db.Text
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  apps                  FactoryApp[]

  @@map("factory_release_accounts")
}

// 업로드 키 비밀번호 임시 보관. 통제실에서 입력한 값을 암호화해 두었다가, PC 감독 프로그램이 가져가 secrets.env 에 저장하면 sealed 를 비운다.
// 키 단위(경로+별칭)로 구분한다. 값은 어떤 화면·API 응답에도 다시 나오지 않는다(등록됨 표시만).
model FactoryKeyPassword {
  keyRef       String    @id // 경로+별칭으로 만든 구분값
  keystorePath String
  keyAlias     String
  storeName    String // PC secrets.env 의 키 저장소 비밀번호 이름
  keyName      String // PC secrets.env 의 키 비밀번호 이름
  sealed       String?   @db.Text // 암호화한 값. PC 가 가져가면 null
  registeredAt DateTime  @default(now())
  deliveredAt  DateTime? // PC 에 저장된 시각

  @@map("factory_key_passwords")
}

// ── 공장 정비(공장 자체를 고치는 대화형 스레드). 앱 일감(FactoryJob)과 따로 둔다 ──
// 스레드 하나 = 정비 대화 하나. 사용자 지시마다 감독 프로그램이 정비 전용 체크아웃에서 같은 Claude 세션을 이어(--resume) 처리한다.
// 결과는 검사를 통과해야 GitHub main 에 올라가고, 서버 코드가 바뀌었으면 사람이 [배포]를 눌러야 서버에 반영된다.
model FactoryMaintenance {
  id                String                      @id @default(cuid())
  title             String
  status            String                      @default("open") // open | closed
  sessionId         String? // Claude 세션 id(이어서 하기)
  pushedCommit      String? // 마지막으로 GitHub 에 올린 커밋
  needsDeploy       Boolean                     @default(false) // 서버 코드가 바뀌어 배포가 필요한지
  deployCommit      String? // 배포하라고 한 커밋
  deployRequestedAt DateTime?
  deployStartedAt   DateTime?
  deployedAt        DateTime?
  deployResult      String?                     @db.Text
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  messages          FactoryMaintenanceMessage[]
  deploys           FactoryDeploy[]

  @@index([updatedAt])
  @@map("factory_maintenance")
}

model FactoryMaintenanceMessage {
  id            String             @id @default(cuid())
  maintenanceId String
  role          String // user(지시) | assistant(결과) | log | system
  text          String             @db.Text
  status        String? // user 지시: awaiting_approval | queued | running | done | failed | cancelled
  source        String? // 통제실 | 채팅
  createdAt     DateTime           @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  heartbeatAt   DateTime?
  maintenance   FactoryMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([maintenanceId, createdAt])
  @@index([status])
  @@map("factory_maintenance_messages")
}

// 서버 배포 이력. [배포]를 누를 때마다 한 줄. (FactoryMaintenance 의 deploy* 열은 "마지막 배포" 상태로 그대로 쓴다)
model FactoryDeploy {
  id            String             @id @default(cuid())
  maintenanceId String
  commit        String
  via           String? // 통제실 | 텔레그램
  requestedAt   DateTime           @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  ok            Boolean? // null = 아직 결과 없음
  result        String?            @db.Text
  maintenance   FactoryMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([requestedAt])
  @@index([maintenanceId, requestedAt])
  @@map("factory_deploys")
}

// 감독 프로그램 업데이트 이력. 감독 프로그램이 /next 로 알려 주는 커밋·소식이 바뀔 때마다 한 줄.
model FactorySupervisorEvent {
  id         Int      @id @default(autoincrement())
  at         DateTime @default(now())
  fromCommit String? // 커밋이 바뀌었을 때 이전 커밋
  commit     String // 그때의 커밋
  subject    String? // 그 커밋의 메시지 첫 줄(감독 프로그램이 보낸 것)
  note       String? // 최근 자동 업데이트 소식

  @@index([at])
  @@map("factory_supervisor_events")
}
