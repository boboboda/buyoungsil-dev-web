{
  "schema": 1,
  "type": "agent",
  "id": "T",
  "kind": "tool",
  "label": "도구 일감",
  "migrated": true,
  "summary": "AI 없이 결과물 카드의 도구·방법·옵션을 감독 프로그램이 바로 실행한다. 일감마다 임시 폴더 tooljobs/<일감>에서만 돈다.",
  "engine": {
    "allowed": [
      "none"
    ],
    "default": "none",
    "model": {}
  },
  "workspace": {
    "type": "tool-folder",
    "root": "tooljobs"
  },
  "tools": {
    "mode": "none",
    "allow": [],
    "deny": [],
    "allowFromConfig": false
  },
  "cli": {
    "style": "none"
  },
  "paths": {
    "allow": [],
    "deny": []
  },
  "network": {},
  "hooks": [],
  "env": {
    "filter": "safeEnv",
    "set": {}
  },
  "keys": {
    "decision": "tool-method"
  },
  "prompt": {
    "template": "none",
    "rules": null
  },
  "after": [
    "art-upload",
    "report"
  ],
  "limits": {
    "timeoutFrom": "config.jobTimeoutMin",
    "input": {
      "maxSubjects": 8,
      "maxCount": 8,
      "maxTotal": 16
    }
  },
  "next": [
    "report"
  ]
}
