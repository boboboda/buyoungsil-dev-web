{
  "schema": 1,
  "type": "flow",
  "id": "app-revision",
  "label": "수정",
  "appliesTo": {
    "jobKind": "revision"
  },
  "steps": [
    {
      "id": "conduct",
      "label": "지휘자",
      "agent": "C1",
      "optional": true,
      "when": "same-app-pending>=2"
    },
    {
      "id": "work",
      "label": "작업자",
      "agent": "A2",
      "variants": [
        {
          "when": "grouped",
          "agent": "A3"
        },
        {
          "when": "rebase-conflict",
          "agent": "A4"
        }
      ]
    },
    {
      "id": "merge",
      "label": "합치기 검사",
      "gate": "merge-check"
    },
    {
      "id": "approve",
      "label": "승인",
      "gate": "approval"
    },
    {
      "id": "deploy",
      "label": "배포",
      "gate": "deploy"
    }
  ]
}
