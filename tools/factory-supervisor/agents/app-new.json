{
  "schema": 1,
  "type": "agent",
  "id": "A1",
  "kind": "new",
  "label": "새 앱",
  "summary": "기획서(PLAN.md)대로 새 앱의 MVP 를 만든다. 앱 폴더에서 돈다.",
  "migrated": true,
  "engine": {
    "allowed": [
      "claude",
      "codex"
    ],
    "default": "claude",
    "model": {
      "claude": "job",
      "codex": "config"
    }
  },
  "workspace": {
    "type": "app-folder"
  },
  "tools": {
    "mode": "acceptEdits",
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [],
    "allowFromConfig": true
  },
  "cli": {
    "style": "stream",
    "output": "stream-json"
  },
  "paths": {
    "allow": [],
    "deny": [
      "edit:@protected/**",
      "edit:@factory/*.json",
      "edit:@factory/*.sh",
      "edit:@factory/secrets.env",
      "read:@factory/supervisor.config.json",
      "read:@factory/secrets.env",
      "read:~/.ssh/**",
      "read:~/.aws/**"
    ],
    "settingsFile": "app-claude-settings.json"
  },
  "network": {
    "codex": "off"
  },
  "hooks": [
    "ssh-guard"
  ],
  "env": {
    "filter": "safeEnv",
    "set": {
      "FACTORY_APP_SLUG": "@job.appSlug",
      "FACTORY_JOB_ID": "@job.id"
    }
  },
  "keys": {
    "decision": "job-required"
  },
  "prompt": {
    "template": "app-new",
    "rules": "app-rules-block"
  },
  "after": [
    "verify",
    "commit",
    "outbox",
    "compact",
    "report"
  ],
  "limits": {
    "timeoutFrom": "config.jobTimeoutMin"
  },
  "next": [
    "verify"
  ]
}
