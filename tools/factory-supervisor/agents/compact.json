{
  "schema": 1,
  "type": "agent",
  "id": "H1",
  "kind": "cleanup",
  "label": "정리",
  "migrated": false,
  "summary": "끝난 세션에 /compact 를 보내 컨텍스트를 정리하는 짧은 턴. 부른 일감의 권한 설정 파일을 그대로 쓰므로 정의는 기록용이다.",
  "engine": {
    "allowed": [
      "claude"
    ],
    "default": "claude",
    "model": {
      "claude": "config"
    }
  },
  "workspace": {
    "type": "app-folder"
  },
  "tools": {
    "mode": "acceptEdits",
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [],
    "allowFromConfig": true
  },
  "cli": {
    "style": "stream",
    "output": "stream-json"
  },
  "paths": {
    "managedBy": "부른 일감(앱·정비)의 권한 설정 파일"
  },
  "network": {
    "codex": "off"
  },
  "hooks": [
    "ssh-guard"
  ],
  "env": {
    "filter": "safeEnv",
    "set": {}
  },
  "keys": {
    "decision": "none"
  },
  "prompt": {
    "template": "compact",
    "rules": null
  },
  "after": [
    "report"
  ],
  "limits": {
    "timeoutMs": 120000
  },
  "next": []
}
