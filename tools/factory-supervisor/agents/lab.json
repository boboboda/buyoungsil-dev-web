{
  "schema": 1,
  "type": "agent",
  "id": "L1",
  "kind": "lab",
  "label": "실험",
  "migrated": true,
  "summary": "도구·방식이 되는지 보는 실험. 공장 폴더는 읽기만, 실험 폴더(lab/<일감>, lab/shared)에서만 쓰고 인터넷을 쓴다.",
  "engine": {
    "allowed": [
      "claude",
      "codex"
    ],
    "default": "claude",
    "model": {
      "claude": "job",
      "codex": "config"
    }
  },
  "workspace": {
    "type": "lab-folder",
    "root": "lab"
  },
  "tools": {
    "mode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [],
    "allowFromConfig": false
  },
  "cli": {
    "style": "stream",
    "output": "stream-json"
  },
  "paths": {
    "allow": [
      "read:@factory/**",
      "edit:@work/**",
      "edit:@shared/**",
      "Bash"
    ],
    "deny": [
      "edit:@entries",
      "edit:@protected/**",
      "edit:@factory/*.json",
      "edit:@factory/*.sh",
      "edit:@factory/secrets.env*",
      "read:@factory/supervisor.config.json",
      "read:@factory/secrets.env*",
      "read:~/.ssh/**",
      "read:~/.aws/**"
    ],
    "additionalDirectories": [
      "@shared"
    ],
    "entriesExcept": [
      "lab"
    ],
    "settingsFile": "lab/.settings/{jobId}.json"
  },
  "network": {
    "codex": "on",
    "writableRoots": [
      "@shared"
    ]
  },
  "hooks": [
    "ssh-guard"
  ],
  "env": {
    "filter": "safeEnv",
    "set": {
      "FACTORY_JOB_ID": "@job.id",
      "FACTORY_LAB_JOB_ID": "@job.id",
      "FACTORY_LAB_DIR": "@dir",
      "FACTORY_LAB_SHARED": "@shared"
    }
  },
  "keys": {
    "decision": "none"
  },
  "prompt": {
    "template": "lab",
    "rules": null
  },
  "after": [
    "lab-repo-check",
    "upload-outputs",
    "report"
  ],
  "limits": {
    "timeoutFrom": "config.jobTimeoutMin"
  },
  "next": [
    "report"
  ]
}
